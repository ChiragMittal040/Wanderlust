 <% layout("../layouts/boilerplate")  %>
<body>
    <div class="row mt-3">    
        <div class="col-8 offset-2">      

    <h2>Create New Account Procced to : </h2>
    <form method="post" 
    action="/listings" 
    novalidate 
    class="needs-validation" 
    enctype="multipart/form-data"
    >
        <div class="mb-3"> 
            <label for="title" class="form-label" >Title</label>         
        <input type="text" name="listing[title]" placeholder="title" class="form-control" required>
        <div class="valid-feedback">Tittle is good!</div>
        </div>

        
        
        <div>
            <label for="description" class="form-label">Description</label>
             <textarea type="text" name="listing[description]"  placeholder="description" class="form-control" required></textarea> 
             <div class="valid-feedback">Tittle is good!</div>
        </div>

         
        <div>
            <label for="image" class="form-label">Upload Listing Image</label>
              <input type="file" name="listing[image]"  class="form-control"  />
              required
        </div>
         
        <div class="row">
            <div class="md-3 col-md-4">
                <label for="price" class="for-label">Price</label>
               <input  type="text" name="listing[price]" placeholder="price" class="form-control" required/>
               <div class="invalid-feedback">Please enter the valid Price!</div>
            </div>
        

        <div class="md-4 col-md-8">
             <label for="country" class="form-label">Country</label>                            
             <input type="text" name="listing[country]" placeholder="country" class="form-control" required/>
             <div class="invalid-feedback">Please enter the country name!</div>
        </div>
        
           </div>
      
       
             <div>
            <label for="location" class="form-label">Location</label>
                            
                <input type="text" name="listing[location]"  placeholder="location" class="form-control" required/>
                 <div class="invalid-feedback">Location should be valid</div>
        </div>  
 

             <div>
            <label for="location" class="form-label">Category</label>
                            
                <select type="text" name="listing[category]"  placeholder="Category" class="form-control" required/>
                  <option value="" selected disabled>Select a category</option>
                  <% for(let category of categories) { %>
                    <option value="<%=category %>"><%= category %> </option>
                    <% } %>                 
                </select>
                <div class="invalid-feedback">Please select a category</div>
        </div>    
        
        <br/>         
     
    <button class="btn btn-dark add-btn mt-3">Add</button>
       <br/><br/>   
    </form>
     </div> 
     </div>  

</body>
 